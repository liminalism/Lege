diff --git a/lege-pdf/render/crates/pdf-content/src/lower.rs b/lege-pdf/render/crates/pdf-content/src/lower.rs
index accfec7..db5cc6d 100644
--- a/lege-pdf/render/crates/pdf-content/src/lower.rs
+++ b/lege-pdf/render/crates/pdf-content/src/lower.rs
@@ -552,11 +552,24 @@ impl<'a> Lowerer<'a> {
         let metrics = sem.metrics.clone();
         let glyph_map = sem.glyph_map.clone();
         let font = self.intern_font(run.font.index());
-        let glyphs = placed_glyphs(&run, &metrics, &glyph_map);
+        let mut glyphs = placed_glyphs(&run, &metrics, &glyph_map);
+        // PROBE P3 fix candidate (B4): fold Th into the run matrix so glyph
+        // *shapes* are scaled too (Trm = [Tfs*Th 0 0 Tfs 0 Ts] x Tm); the
+        // placements are re-expressed in the pre-Th frame. Th == 1 keeps the
+        // exact old matrix and positions.
+        let th = run.horizontal_scale / 100.0;
+        let transform = if th != 1.0 && th.is_normal() {
+            for g in &mut glyphs {
+                g.x /= th;
+            }
+            Matrix::scale(th, 1.0).then(run.text_matrix)
+        } else {
+            run.text_matrix
+        };
         let compiled = GlyphRun {
             font,
             font_size: run.font_size,
-            transform: run.text_matrix,
+            transform,
             glyphs: glyphs.into(),
             render_mode: run.render_mode,
         };
