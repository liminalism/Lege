     clock: u64,
+    /// Lookup counters, bumped while the shard lock is already held, so the
+    /// per-glyph probe performs no extra atomic read-modify-write on a line
+    /// shared by every render worker. Summed across shards by `stats()`.
+    hits: u64,
+    misses: u64,
 }
 
