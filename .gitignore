# Rust and generated build output
/target/
**/target/
**/dist/
**/fuzz/target/

# Local editor, assistant, and indexing state
/.vs/
/.vscode/
/.claude/
/.codegraph/
**/.vs/
**/.vscode/
**/.idea/
**/.claude/
**/.codegraph/
**/.codex
.filter-tmp/

# Android Studio's per-machine SDK location and generated native library output.
lege-android/local.properties
lege-android/app/src/main/jniLibs/
lege-android/.gradle/
lege-android/build/
lege-android/app/build/
lege-android/app/release/

# Local caches, logs, and databases
*.log
*.db
*.db-shm
*.db-wal
*.sqlite
*.tmp
*.temp

# OS metadata
.DS_Store
Thumbs.db

# Backups and packaged source snapshots
*.bk
*.old
*.orig
*.zip
*.tar
*.tar.gz

# Non-source documents and one-off local migration helpers
*.pdf
# Small PDF fixtures are source inputs required by fresh-clone test builds.
!lege-pdf/render/crates/pdf-document/tests/fixtures/*.pdf
!lege-pdf/render/crates/pdf-chaos-tests/tests/fixtures/*.pdf
!lege-pdf/pdf-integrity/fixtures/*.pdf
/cargo-checker
/cargo-checker.exe
**/cargo-checker
**/cargo-checker.exe
/agent-pack
**/agent-pack
/wipe-github-remote.sh
/wipe.ps1

# Screenshots and scratch captures (dev artifacts; some names are invalid on Windows)
Screenshot*.png
Screenshot*.PNG
# The processor README ships these two images.
!lege-process/Screenshot2.png
!lege-process/page_0002-original.png

# Downloaded third-party build tools (re-fetched by packaging scripts)
*.AppImage

# Codec test corpora and generated visual outputs (dev artifacts)
lege-codecs/jp2lam/test-set/
lege-codecs/jp2lam/visual-output/
lege-codecs/jp2lam/lear.png
lege-pdf/oracle-sweep-*/
lege-pdf/render/corpus/perf/results/
# Same sweeps after the move under sources/. Registered AKR sources
# (catalog.json, external/) stay tracked; only the bulk sweep payload is not.
sources/oracle-sweep-*/

# Generated codec output samples
*.jp2
*.j2k
*.jb2
*.pbm

# AKR: a rebuildable cache and disposable agent notes.
.akr/cache/
.agent/scratch/
.agent/handoffs/
# The pattern above contains a slash, so git anchors it to this directory and
# it misses nested crates (e.g. lege-codecs/jp2lam/.agent/scratch/).
**/.agent/scratch/

# Scratch render output from pipeline runs. Page PNGs at 12MP run to tens of
# megabytes and git history is permanent.
/tmp/

# Logo exploration and export renders. Large JPEG sets; the shipped icons live
# in lege-misc/assets/ directly.
lege-misc/assets/logo-concepts/
lege-misc/assets/logo-export/
