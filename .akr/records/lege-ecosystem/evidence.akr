record lege-ecosystem.evidence.djvu-runtime-helper-final-scan-20260822/1 : evidence {
    title "Final direct-DjVu runtime and licensing surface scan passed"
    state verified
    result pass
    method command
    observed_at git:3f520cc03211e48adaa77c1da9bc639c53d2d351
    command "if rg -n 'LEGE_DJVU_ENCODER|djvu_encoder_path|resolve_encoder_path|DjvuEncoderManifest|EncoderControl|djvu-encoder|Contents/Helpers' lege-process/core lege-process/pipeline --glob '*.rs'; then exit 1; fi; if rg -n 'LEGE_DJVU_ENCODER|djvu-encoder|Contents/Helpers|djvulibrust' lege-process/scripts; then exit 1; fi; bash -n lege-process/scripts/build-macos-app.sh lege-process/scripts/build-macos-app-silicon.sh; cargo metadata --no-deps --format-version 1 | jq -e '[.packages[] | select(.name == \"lege\" or .name == \"lege-android\" or .name == \"lege-gui\" or .name == \"lege-gui-freya\" or .name == \"lege-music-gui\" or .name == \"lege-ipc\") | .license] | length == 6 and all(. == \"AGPL-3.0-only\")'; cmp -s LICENSE lege-process/LICENSE; rg -q '^license = \"AGPL-3.0-only\"$' Cargo.toml lege-process/Cargo.toml lege-android/Cargo.toml; git diff --check"
    summary """
        Final scan found no Lege DjVu runtime helper/subprocess identifiers or macOS helper packaging; both package scripts parsed, top-level application metadata resolved uniformly to AGPL-3.0-only, license texts matched, and the diff had no whitespace errors.
        """
}

