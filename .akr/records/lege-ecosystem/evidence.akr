record lege-ecosystem.evidence.document-ocr-cli-suite-20260908/1 : evidence {
    title "lege-document-ocr-cli suite fails on Linux at 823d46dd"
    state verified
    result fail
    method command
    observed_at git:823d46ddc946bb5d6ac8fc360a9d9ba6506d7a7d
    command "cargo test -p lege-document-ocr-cli"
    summary """
        2 passed, 1 failed. tests::native_text_batch_exports_and_resumes_without_invoking_ocr
        panics in run_batch with "backend `winocr-legacy` is not available in this build or on this
        platform" (lege-document-ocr/cli/src/main.rs:849). The test deliberately selects an
        unavailable backend to prove a native-text PDF never reaches OCR, but
        DocumentProcessor::new initializes the backend eagerly
        (lege-document-ocr/crates/pipeline/src/lib.rs:129-133), so construction fails before any
        page is classified. The test was added in 27900f0e, after b6c6ae48 made initialization
        eager, and has therefore never passed on a non-Windows host.
        """
}

