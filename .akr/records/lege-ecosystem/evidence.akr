    observed_at git:823d46ddc946bb5d6ac8fc360a9d9ba6506d7a7d
    summary """
        Ledger-cleanup pass of 2026-09-08 dispositioned every claim imported from the five
        lege-codecs/jp2lam/decode-fix-plan documents. Each claim had already been promoted to
        its own work record by the 2026-08 bulk import. Each promoted record was then reviewed
        against lege-codecs/jp2lam/src at HEAD and given a terminal disposition: the four still
        actionable ones were kept live (lege-ecosystem.work.handoff-remaining-jp2lam-jpeg-2000-decode-gaps,
        lege-ecosystem.work.zero-length-code-block-contribution-truncated,
        lege-ecosystem.work.pdf-renderer-follow-ups-outside-pure-codec and
        lege-ecosystem-perf.jp2.decode-optimization-handoff-2026-08-09); their real status was
        consolidated into lege-ecosystem.work.jp2lam-jpeg-2000-decoder-optimization-plan, which now
        names what landed, the fused-pack SIMD negative result, and the seven genuinely open items;
        and the remaining 125 records, which the importer had produced from report prose and section
        headings (often pairing a heading with an unrelated adjacent paragraph as its intent), were
        abandoned with that reason recorded on each. No claim was left undispositioned.
        """
}

record lege-ecosystem.evidence.det-limit-side-sweep-20260822/1 : evidence {
    title "Detector limit_side 1280 beats 960 and 1600 for PP-OCRv6 on wgpu"
    state verified
    result pass
    method command
    observed_at git:3f520cc03211e48adaa77c1da9bc639c53d2d351
    command "python3 lege-document-ocr/scripts/score_ocr_accuracy.py --reference lege-document-ocr/scripts/benchmarks/book-page-wgpu-2026-08-22/reference.txt --candidate limit-960=.../ppocrv6-wgpu-limit960.txt --candidate limit-1280=.../ppocrv6-wgpu-limit1280.txt --candidate limit-1600=.../ppocrv6-wgpu-limit1600.txt"
    artifact "lege-document-ocr/scripts/benchmarks/book-page-wgpu-2026-08-22/"
    summary """
        Embedded PP-OCRv6 small on the wgpu path, reading lege-process/page_0002-original.png (961x1400) against a hand transcription: limit 960 scored CER 0.25% / WER 2.81% in 7.28s, limit 1280 scored CER 0.25% / WER 2.41% in 8.31s, limit 1600 scored CER 0.31% / WER 3.21% in 8.23s. 1280 ships. 1600 exceeds the page's own long side so no resize happens, and it scores worst, indicating the downscale suppresses scan noise. The margin is about one word on 249, and the page's 1400px long side means this cannot speak to 300 DPI input; residual errors are dominated by lost inter-word spaces at a scan shading boundary, which every cap shares.
        """
}

