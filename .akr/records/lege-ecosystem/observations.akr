record lege-ecosystem.observation.truetyping-halftone-review-fixes-20260905/1 : observation {
    title "All ten findings of the 2026-09-05 TrueTyping/halftone review are fixed and corpus-validated"
    state superseded
    scope [ path "lege-codecs/jbig2enc-rust/**", path "lege-process/**" ]
    statement """
        Implemented at working tree on 2325cfd6 (uncommitted): jbig2enc halftone emits ceil(log2(patterns)) gray-code planes, edge cells are edge-replicated, quantizer and dictionary agree on round(i*M*M/(N-1)) populations, sharpening_l is a real unsharp mask (default 0.0 keeps prior output), lossless doc is honest; paper whitening rolls off smoothly above PAPER_WHITE_FLOOR (color_processing::halftone_ink_from_gray). TrueTyping: components that cannot be valid simple glyphs (size, contour or point budget) go to a per-page lossless JBIG2 residual drawn under the text; truetype_writer returns errors instead of narrowing counts; one outline recognised as two strings gets two CIDs; the OCR layer keeps words no glyph covers; Freya gates halftone on the effective encoder and clears it when reflow is entered. Tests: jbig2enc 211 pass (1 pre-existing failure decode_refine_templates::grtemplate1_tpgron), lege lib 338 pass. Corpus: 20-page subsets of the three largest to-sort books (globalhistory, crusades, wheels) with --text-format truetyping --halftone decode cleanly in mutool, every page has normal ink coverage, line-art map pages survive via the residual, halftoned photos have correct tone. Validation first exposed the fixed-threshold CLI default (see decision simple-cli-default-binarization-is-adaptive).
        """
    observed_at git:2325cfd672cc1eb52b5b54642f5a0da71aabe7d0
    method command
    watches [
        "lege-codecs/jbig2enc-rust/src/encode/halftone.rs",
        "lege-process/encoding/glyphfont.rs",
        "lege-process/core/pdf_artifact.rs",
        "lege-process/core/truetype_writer.rs"
    ]
    derived_from [ @lege-ecosystem.observation.truetyping-halftone-review-20260905 ]
}

record lege-ecosystem.observation.truetyping-halftone-review-fixes-20260905/2 : observation {
    title "All ten findings of the 2026-09-05 TrueTyping/halftone review are fixed and corpus-validated"
    state verified
    scope [ path "lege-codecs/jbig2enc-rust/**", path "lege-process/**" ]
    statement """
        Implemented at working tree on 2325cfd6 (uncommitted): jbig2enc halftone emits ceil(log2(patterns)) gray-code planes, edge cells are edge-replicated, quantizer and dictionary agree on round(i*M*M/(N-1)) populations, sharpening_l is a real unsharp mask (default 0.0 keeps prior output), lossless doc is honest; paper whitening rolls off smoothly above PAPER_WHITE_FLOOR (color_processing::halftone_ink_from_gray). TrueTyping: components that cannot be valid simple glyphs (size, contour or point budget) go to a per-page lossless JBIG2 residual drawn under the text; truetype_writer returns errors instead of narrowing counts; one outline recognised as two strings gets two CIDs; the OCR layer keeps words no glyph covers; Freya gates halftone on the effective encoder and clears it when reflow is entered. Tests: jbig2enc 211 pass (1 pre-existing failure decode_refine_templates::grtemplate1_tpgron), lege lib 338 pass. Corpus: 20-page subsets of the three largest to-sort books (globalhistory, crusades, wheels) with --text-format truetyping --halftone decode cleanly in mutool, every page has normal ink coverage, line-art map pages survive via the residual, halftoned photos have correct tone. Validation first exposed the fixed-threshold CLI default (see decision simple-cli-default-binarization-is-adaptive).
        """
    observed_at git:823d46ddc946bb5d6ac8fc360a9d9ba6506d7a7d
    method command
    watches [
        "lege-codecs/jbig2enc-rust/src/encode/halftone.rs",
        "lege-process/encoding/glyphfont.rs",
        "lege-process/core/pdf_artifact.rs",
        "lege-process/core/truetype_writer.rs"
    ]
    derived_from [ @lege-ecosystem.observation.truetyping-halftone-review-20260905 ]
    supersedes [ @lege-ecosystem.observation.truetyping-halftone-review-fixes-20260905/1 ]
    verified_by [ @lege-ecosystem.evidence.stale-observation-requeue-20260908/1 ]
}

record lege-ecosystem.observation.truetyping-letters-ride-off-their-baseline/1 : observation {
    title "Truetyping letters sit a pixel or two off the baseline, and identical shapes make it obvious"
    state superseded
    scope [
        path "lege-process/core/pdf_artifact.rs",
        path "lege-process/encoding/glyphfont.rs"
    ]
    statement """
        In truetyping output, individual letters within a word sit a pixel or two above where they belong — `this` with its `is` riding high, `doomed in any` with the `in` lifted — while the line as a whole is level. The user reported it after the substitution fixes landed, and it is visible on page 500 of the 836-page Gernet run (`~/Downloads/lege-review-2026-09-03/truetyping-vertical-wobble-p500.png`, rendered at 1400 px working height). The effect is amplified by how completely the dictionary deduplicates: every `e` on the page is the same outline, so the only variation left between them is their height, and the eye reads that as letters out of place. JBIG2 symbol mode, which shares the same shapes through the same clustering, does not show it; sym-unify is not the comparison, plain symbol mode is.
        """
    observed_at git:9925fb523be7d23bdf664b1aa66dd9ae44ecc1ee
    method observation
    watches [ "lege-process/encoding/glyphfont.rs", "lege-process/core/pdf_artifact.rs" ]
    claim a-pixel-is-a-tenth-of-a-letter-at-this-height {
        text """
            The snap is one pixel of the *working* raster, so its visual weight depends on the render height: at the 1400 px this book was traced at, body type is about ten pixels, and a pixel is a tenth of the x-height.
            """
    }
    claim jbig2-shares-the-shape-but-not-the-position {
        text """
            JBIG2 symbol mode carries each occurrence's own top-left on the page (`TextRegionSymbolInstance { x, y }`, jbig2enc-rust dictionary.rs:645) beside the shared symbol id, so a shared bitmap costs nothing in placement. Truetyping shares the shape *and* the position: an occurrence is drawn at its prototype's descent, not its own.
            """
    }
    claim the-prototypes-descent-comes-from-one-page {
        text """
            `fix_new_prototype_metrics` fixes a prototype's descent once, as the lower median of its occurrences on the page that created it; every later page is measured against that page's estimate, and nothing revises it.
            """
    }
    claim the-vertical-residual-is-thrown-away-or-turned-into-a-glyph {
        text """
            `GlyphDictionary::process_analysis` replaces an occurrence's measured bottom with its prototype's `descent`: a residual within `RISE_SNAP_PX` (1 px of the working raster) is snapped to zero, and a larger one becomes a *position variant*, a second glyph whose own descent was fixed by its first instance and which then absorbs later occurrences within `VARIANT_JOIN_PX` (also 1 px).
            """
    }
}

