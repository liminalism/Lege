record lege-ecosystem.observation.jbig2-symbol-mode-is-lossy/3 : observation {
    title "Legacy symbol substitution is lossy; explicit exact symbol presets now preserve input pixels"
    state superseded
    scope [ path "lege-codecs/jbig2enc-rust/**", path "lege-process/**" ]
    statement """
        As of the 2026-11-01 working tree on HEAD95b571373a37c199ce92e0ce9c80d7c8a5ff6464, legacy Jbig2Config::text() and text_symbol_unify() remain intentionally lossy and their original byte-hash baselines remain unchanged. The earlier 175/1215-pixel legacy fixture findings and old size comparisons describe that legacy path, not all current configurations. New text_lossless() retains every component, disables input-changing cleanup/substitution, uses full bitmap equality, and preserves nonmatches through separate dictionary/generic representations; its measured variant additionally chooses exact refinement using full-stream costs. All782 confed pages pass exact native/jbig2dec equality in32/64/128/whole-book groups. The17-page mixed corpus passes native/jbig2dec/PDFium/Poppler with zero exact differences, whereas explicit measured lossy output reports20 source differences. New presets use canonical arithmetic termination; legacy callers may select it explicitly without changing pixel fidelity. This supersedes the old blanket claim that no symbol-mode configuration is exact. The Lege application's existing default/GUI/Python exposure was not changed to select the new preset by this crate work; use the explicit library constructor. No source-rights clearance is inferred from codec fidelity.
        """
    observed_at git:95b571373a37c199ce92e0ce9c80d7c8a5ff6464
    method instrumented
    watches [
        "lege-codecs/jbig2enc-rust/src/encode/**",
        "lege-codecs/jbig2enc-rust/tests/exact_symbols.rs"
    ]
    supersedes [ @lege-ecosystem.observation.jbig2-symbol-mode-is-lossy/2 ]
    verified_by [
        @lege-ecosystem.evidence.jbig2-070-canonical-package-20261101,
        @lege-ecosystem.evidence.jbig2-070-canonical-termination-20261101,
        @lege-ecosystem.evidence.jbig2-070-exact-components-20261101
    ]
    acknowledged true
    author "dk"
}

