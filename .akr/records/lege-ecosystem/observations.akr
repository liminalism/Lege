record lege-ecosystem.observation.jbig2enc-inert-config-fields/1 : observation {
    title "Three jbig2enc-rust config fields are inert in the encoder"
    state superseded
    scope [ path "lege-codecs/jbig2enc-rust/**" ]
    statement """
        Jbig2Config::{dpi, duplicate_line_removal, match_tolerance} do not change encoder output. Measured on a 480x320 glyph page via encode_single_image_with_config: default 2876 bytes, and dpi=600, duplicate_line_removal=false and match_tolerance in {4,7,10} all produced 2876 bytes byte-for-byte. match_tolerance is only read when config.text_refine is set (encode/document.rs:451), and produced identical output (1046 bytes) at every tolerance even with text_refine enabled. By contrast symbol_mode=true works as documented (2876 -> 1027 bytes) and is required for a shared /JBIG2Globals dictionary. Consequence: the jbig2enc Python binding deliberately exposes only symbol_mode, refine and the lossless preset, and rejects the three inert names as unknown options rather than accepting them silently.
        """
    observed_at git:dd69931cda0595bdf08caa422f3966bf484fb47c
    method command
    watches [ "lege-codecs/jbig2enc-rust/src/encode/**" ]
}

