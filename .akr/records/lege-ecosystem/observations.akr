record lege-ecosystem.observation.jbig2enc-inert-config-fields/3 : observation {
    title "Legacy config invariance measurements do not imply all current symbol paths ignore tolerance or DPI"
    state verified
    scope [ path "lege-codecs/jbig2enc-rust/**" ]
    statement """
        2026-11-01 working-tree source review on HEAD95b571373a37c199ce92e0ce9c80d7c8a5ff6464: the earlier480x320 fixture's unchanged outputs under dpi/duplicate_line_removal/match_tolerance were measurements of that historical legacy path, not proof of general field inertness. Current match_tolerance is read by legacy refinement in document.rs and by the new bounded planner candidate threshold in symbol/optimizer.rs, plus topology-safe unify/refinement guards in unify_apply.rs. Exact matches and selected refinements still preserve pixels; the explicit measured lossy per-instance error cap remains separate. Top-level dpi is read by exact component extraction with cleanup disabled; that read alone does not prove a byte change for a particular input. duplicate_line_removal still has no runtime read in the inspected encoder sources outside configuration construction; exact presets force it false. No new Python option exposure was added here, and the binding's prior rejection behavior was not remeasured in this review. Constructors plus documented field scope should guide callers; the old three-field blanket inertness claim is no longer a safe description of every current encoding path.
        """
    observed_at git:95b571373a37c199ce92e0ce9c80d7c8a5ff6464
    method manual
    watches [ "lege-codecs/jbig2enc-rust/src/encode/**" ]
    supersedes [ @lege-ecosystem.observation.jbig2enc-inert-config-fields/2 ]
    verified_by [ @lege-ecosystem.evidence.jbig2-070-canonical-package-20261101 ]
    acknowledged true
    author "dk"
}

record lege-ecosystem.observation.jbig2enc-py-round-trip-verified/1 : observation {
    title "jbig2enc Python binding round-trips pixel-exactly in every mode"
    state superseded
    scope [ path "lege-misc/bindings/jbig2enc-py/**" ]
    statement """
        The jbig2enc pyo3 binding encodes and decodes back byte-identical pixels on a 480x320 glyph page in all exercised modes: standalone generic region (2876 B), standalone symbol mode (1027 B), PDF fragment without globals, PDF fragment with a 64-byte shared dictionary, and a three-page document sharing one dictionary. Zero differing pixels in every case, so both encoder modes are lossless at the exposed settings and the multi-page shared-dictionary symbol indices line up. Verified through the installed wheel (jbig2enc-0.5.4-cp311-abi3-manylinux_2_34_x86_64) in a clean virtualenv, 20 pytest tests green; cargo clippy --release clean.
        """
    observed_at git:dd69931cda0595bdf08caa422f3966bf484fb47c
    method command
    watches [ "lege-misc/bindings/jbig2enc-py/**", "lege-codecs/jbig2enc-rust/src/**" ]
}

