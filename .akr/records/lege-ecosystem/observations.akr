record lege-ecosystem.observation.renderer-crates-io-readiness-20261109/1 : observation {
    title "Renderer crates.io readiness audit: packaging small, manifests and names block publication"
    state verified
    statement """
        cargo package --list over the 27 lege-pdf crates (2026-11-09): all far below 10 MB (about 2.6 MB total; pdf-font largest at about 0.9 MB). Dev artifacts that would ship: pdf-font/tools/gen_cmaps.py (contains a private /mnt path), pdf-image/tests/fixtures/*.truth.bin and *.src.bin (about 2 MB raw golden outputs), pdf-render-cpu/benches, pdf-postprocess/examples, and pdf-cli, pdf-render-wgpu and pdf-test-support lack publish = false. Blockers: root [workspace.dependencies] pdf-*/jp2lam/jbig2enc-rust entries are path-only with no version; the names pdf-syntax, pdf-color, pdf-font, pdf-content, pdf-text and pdf-cli are taken on crates.io; pdf-image needs the unreleased jp2lam 0.3.1 (DecodeMetadata::reduce_levels); description is missing in most render crates and license in lege-pdf-write and lege-gpu; workspace license is AGPL-3.0-only though CRATES-IO-PLAN.md records MIT as intended, lege-pdf-read says Apache-2.0, and no crate packages a LICENSE file or the Foxit font notice. The candidate names imprim, pinxel, rastra, redda, nitid, pagella, charta and lege-pdf-render were free.
        """
    observed_at git:fd17bdd9c43fa624587a518c292354daa51b81a1
    method command
    watches [ "Cargo.toml", "lege-pdf/**/Cargo.toml", "lege-pdf/CRATES-IO-PLAN.md" ]
    author "dk"
}

record lege-ecosystem.observation.transformer-layout-models-bound-by-naive-matmul/1 : observation {
    title "Transformer layout detectors run on lege-gpu but are ~25x too slow: MatMul/Gemm are untiled"
    state superseded
    statement """
        lege-gpu runs transformer layout detectors correctly but about 25x too slowly, because MatMul and
        Gemm use a naive one-thread-per-output kernel. Measured 2026-11-07 on an RTX 4060 Laptop with random
        weights: PP-DocLayout-M 640x640 takes 32 ms; a DINOv2-S/14-reg backbone takes 705 ms at 644x644 and
        1,941 ms at 1022x728; with a 3-6 layer deformable DETR decoder 744-799 ms and 2,103-2,239 ms. The
        same 2116x384x1536 multiply takes 9.3 ms as MatMul and 0.73 ms as a 1x1 Conv through the tiled
        GEMM (13x). All ops of the custom ViT + deformable DETR export are supported; MatMul needed its
        dispatch moved to the 2-D grid (65535 limit). RF-DETR-S's own export is not runnable: TopK,
        GatherElements, Tile, Expand, Where, ReduceMax, Exp, Sin, Cos. Details:
        D:/projects/google-colab-work/layout-detection/FEASIBILITY.md
        """
    observed_at git:0b5cd5f56dd4bb0c715b931b85a7f971e2455df1
    method command
    watches [
        "lege-gpu/src/vision/ops/matmul.rs",
        "lege-gpu/src/vision/ops/gemm.rs",
        "lege-gpu/src/vision/ops/compile.rs"
    ]
    author "dk"
}

record lege-ecosystem.observation.transformer-layout-models-bound-by-naive-matmul/2 : observation {
    title "lege-gpu runs DETR-family layout detectors: tiled GEMM, wide softmax and the RF-DETR op set"
    state verified
    statement """
        lege-gpu now runs DETR-family layout detectors at usable speed and with the full RF-DETR op set.
        Changes (2026-11-07, uncommitted): MatMul and Gemm route to a register-blocked tiled GEMM (scalar and
        vec4 variants; batched, broadcast and transposed operands; Gemm alpha/beta and all ONNX bias shapes);
        wide-row Softmax uses one workgroup per row with tree reductions; new ops Exp, Sin, Cos, ReduceMax,
        Tile, Expand, Where, runtime Gather (constant indices), GatherElements and TopK (rank selection, exact
        ONNX tie order); BOOL initializers load as 0/1 f32. Measured on an RTX 4060 Laptop, random weights:
        DINOv2-S/14-reg backbone 705 -> 124 ms at 644x644 and 1,941 -> 316 ms at 1022x728; ViT-S + 3-6 layer
        deformable DETR 744-799 -> 147-157 ms at 644x644; PP-DocLayout-M unchanged at 30-32 ms. Pretrained
        RF-DETR-S (512x512, its own export) runs end to end in about 105-130 ms and matches onnxruntime on a
        real book page: boxes max|diff| 1.3e-4, logits 4.4e-4, identical argmax class for all 300 queries.
        Remaining gap to the 100 ms backbone target is attention arithmetic; windowed attention in 8 of 12
        blocks is the model-side fix. Details: D:/projects/google-colab-work/layout-detection/FEASIBILITY.md
        """
    observed_at git:0b5cd5f56dd4bb0c715b931b85a7f971e2455df1
    method command
    watches [
        "lege-gpu/src/vision/ops/matmul.rs",
        "lege-gpu/src/vision/ops/gemm.rs",
        "lege-gpu/src/vision/ops/compile.rs"
    ]
    supersedes [ @lege-ecosystem.observation.transformer-layout-models-bound-by-naive-matmul/1 ]
    author "dk"
}

record lege-ecosystem.observation.truetyping-dictionary-lock-serialized-every-page/1 : observation {
    title "Truetyping's shared glyph dictionary serialized every page's matching behind one mutex, and that lock was the whole critical path"
    state superseded
    scope [ path "lege-process/encoding/glyphfont.rs" ]
    statement """
        On the 886-page archive.org scan crusadeswholesto0000lamb_1.pdf (RGB JPEG pages, traced at 2400 px), truetyping took 17.4 s for 41 pages and 72.8 s for 201 pages where CCITT4 took 5.1 s for the same 41 pages and 35.3 s for the whole book. Rendering (1.7 s total) and binarization were not the cost. GlyphFontSession::process_page_pixels matched a page's 5000 components against the document dictionary while holding the dictionary mutex, single-threaded; the strict search alone was 38 s of the 73 s wall on 201 pages, and the per-instance cost grew with the dictionary (273 candidates per instance at 41 pages, 400 at 200). The four page workers spent most of their time waiting for the lock. Fix: the per-component search is a read-only parallel probe (rayon, one Comparator per thread) and only folding the answers (votes, refreshes, inserts) runs in sequence; a miss is re-searched only among the prototypes the page changed; the end-of-document alias passes probe in parallel the same way; banks finalize concurrently; the bucket index uses a multiplicative hasher. After: 41 pages 8.5 s, 201 pages 25.9 s, the whole book 2 min 0 s, with per-page glyph extraction flat at 143 to 168 ms across the book (98 s of pages, 19 s of finalize, font build and write for 22 font banks). A 65533-id bank fills in roughly 40 pages of this book: 41 pages made 13691 distinct shapes but 41794 glyph ids (13471 position variants, 4307 compounds, 8529 text variants), so the full book carries 22 fonts totalling 41 MB of a 45 MB output; glyph-id consumption by variants, not matching speed, is now the format's largest cost on long books.
        """
    observed_at git:df6bb8cf45e9ee68a6544bbaf9e9136f6cd171d2
    method instrumented
    watches [
        "lege-process/encoding/glyphfont.rs",
        "lege-process/pipeline/pdf_tokio_pipeline.rs"
    ]
    review_after 2026-12-01
    author "GitHub Uploader"
}

