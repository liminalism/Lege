project lege-ecosystem

record lege-ecosystem-perf.observation.decode-flamegraph-lear-2026-08-06/1 : observation {
    title "Decode flamegraph baseline (lear q75 RGB, P-cores)"
    state verified
    statement """
        Flamegraph of the session_packed RGB decode of lear.png (4485x2791,
        irreversible 9/7, q75) at 4 workers pinned to physical P-cores
        (taskset -c 0,2,4,6), event cpu_core/cycles/u, dwarf call-graph, warm
        process. Wall median ~280 ms (~43 MP/s). Self-time leaf hotspots (share
        of cpu_core cycles across 4 threads):
        - 9/7 inverse DWT ~25%: apply_lift_wide 14.2% (already wide-SIMD),
          inverse_97_1d_with_scratch_phase 4.8%, plus _mm_mul_ps/_mm_add_ps.
        - Tier-1/MQ ~22%: MqDecoder::decode_with_ctx 7.3%,
          FlagGrid::neighbour_mask_from_word 4.8%, renormd 2.3%,
          lps_exchange 1.8%, sigpass ~2%.
        - Finalize/pack/color ~15% (scalar): <f32>::clamp 4.7%,
          finalize_centered_f32_u8 4.5%, fuse_pack_f32_into 2.6%,
          store_rgb_layout 1.5%, ict_rgb_f32 1.3%.
        - __memcpy_avx_unaligned_erms 6.1% (DWT band gather/scatter + staging).
        Note: decode_benchmark's bytes_hash closure (~4.7%) is measurement-only
        overhead, not decoder work. Artifacts:
        lege-codecs/jp2lam/.agent/scratch/flamegraphs/jp2lam-lear-2026-08-06/.
        Method transferred from jpegXL-rs: P-cores only + cpu_core event avoids
        hybrid-Intel cpu_atom stack pollution.
        """
    observed_at git:c66f1cad9f227fca6ddcf0e3f52c1a0b7394c93d
    method command
}

record lege-ecosystem-perf.renderer-headsup.font-index-lazy-sparse-20261104/1 : observation {
    title "System font index made lazy and sparse: cold start 133 -> 8 ms"
    state verified
    statement """
        FolderFontProvider (pdf-font system.rs) read every installed font file in full at construction, 389 MB over 535
        entries on this machine, costing ~130 ms before the first page of every cold process; the November harness timed
        that inside every whole-document figure (viaduct 15.7 vs PDFium 60 pages/s was almost entirely this). The index is
        now built lazily on first lookup and reads only the table directory, name and OS/2 tables per file (sparse reader,
        whole-file fallback, parity test over all installed fonts). Viaduct page-0 first visit 133 -> 7.8 ms, viaduct
        whole document 191 -> 50 ms (parity with PDFium), xenosystems 8 workers 739 -> 589 ms. cargo test -p pdf-font passes.
        Uncommitted. Evidence: .agent/scratch/pdf-render-headsup-20261104/variance-investigation.md section 6.
        """
    observed_at git:d39b8f1a81890f6a9f2697c0250e0c604c7d4e68
    method command
    watches [ "lege-pdf/render/crates/pdf-font/src/system.rs" ]
    author "dk"
}

record lege-ecosystem-perf.renderer-headsup.jpx-headroom-fix-20261104/1 : observation {
    title "JPX decode headroom 2 -> 1: MRC scan pages 2.6x faster at 144 DPI, agreement unchanged"
    state verified
    statement """
        Removing the 2x SUPERSAMPLE_HEADROOM from codec_target_size (pdf-render-cpu prepared.rs; now 1.0, override
        PDF_RENDERER_JPX_HEADROOM) lets the JPX codec take the one-level reduction at viewer resolution. Chinese-medicine
        100 pages at 144 DPI: serial 494 -> 191 ms/page (PDFium 185); 8 workers harness env 9.2 -> 23.9 pages/s
        (PDFium 8 procs 30.4); 20 workers automatic 11.0 -> 32.9 pages/s. 72 DPI serial 181-190 -> 79 ms/page (PDFium 64).
        Harness-metric agreement with the retained old-Lege and PDFium rasters is unchanged on 20 sampled pages of
        chinese-medicine, Structures and centralpark at both scales (mean abs diff vs old Lege 0.13-0.45/255);
        cargo test -p pdf-render-cpu passes. Uncommitted in the working tree. Evidence:
        .agent/scratch/pdf-render-headsup-20261104/variance-investigation.md section 5 and variance-investigation/headroom-fix/.
        """
    observed_at git:279debcc0b71e61bf495e71f12c89991883c3323
    method command
    watches [
        "lege-pdf/render/crates/pdf-render-cpu/src/prepared.rs",
        "lege-pdf/render/crates/pdf-image/src/jpx.rs"
    ]
    author "dk"
}

record lege-ecosystem-perf.renderer-headsup.lege-vs-rust-renderers-20261104/1 : observation {
    title "Lege vs Hayro/pdf-render after fixes: Hayro ahead 1.2-3.6x on 7 of 8 documents; gaps are per-core kernels and codecs"
    state verified
    statement """
        With both fixes in, Hayro 0.9.0 renders faster than Lege on 7 of 8 private test documents at 72 and 144 DPI,
        1.2-3.5x serially (P-core pinned) and 1.3-3.6x at eight workers; Lege leads only centralpark at 72 DPI. pdf-render
        1.3 and pdf-toolkit are behind Lege. Hayro is single-threaded per page (vello_cpu num_threads 0) so the gap is
        per-core kernel and codec throughput: sahib 1:1 JPEG draw 44 ms for 4.6 Mpx (bilinear forced at 1:1, scalar loops),
        2x upscale 158 ms; xenosystems page 0 Indexed-image area minification 363 ms in the generic per-tap loop; text
        pages ~1.5x Hayro; jp2lam serial 1.5-2x behind hayro-jpeg2000. Hayro's July standing was never timed (0.7.0 was
        an accuracy control only); 0.8.0 (Oct 4) and 0.9.0 (Nov 2) added glyph caching, hinting, always-on SIMD and
        performance work across syntax, interpret, jpeg2000 and jbig2. Evidence:
        .agent/scratch/pdf-render-headsup-20261104/variance-investigation.md section 8, variance-investigation/rust-renderers/.
        """
    observed_at git:5951f37ae9248a80878bee52481191af832ddf21
    method command
    watches [
        "lege-pdf/render/crates/pdf-render-cpu/src/exec.rs",
        "lege-pdf/render/crates/pdf-render-cpu/src/prepared.rs",
        "lege-pdf/CRATES-IO-PLAN.md"
    ]
    author "dk"
}

record lege-ecosystem-perf.renderer-headsup.memory-lege-vs-pdfium-processes-20261104/1 : observation {
    title "Memory: 8 PDFium processes ~1.8x one 8-worker Lege process, not 8x"
    state verified
    statement """
        Peak process-tree RSS, chinese-medicine at 144 DPI, after the JPX headroom fix: Lege 1 worker 225-230 MB, 8 workers
        374-408 MB (was 1,000 MB before the fix), 20 workers 470-565 MB. PDFium: 1 process 177 MB and 8 processes 708 MB
        when the document is opened from the file; the harness's worker keeps two in-memory copies of the 85 MB file per
        process and recorded 339 / 2,172 MB. Eight PDFium processes therefore cost ~1.8x Lege's eight workers, not 8x.
        Evidence: .agent/scratch/pdf-render-headsup-20261104/variance-investigation.md section 7 and variance-investigation/memory/.
        """
    observed_at git:d39b8f1a81890f6a9f2697c0250e0c604c7d4e68
    method command
    watches [
        "lege-pdf/render/crates/pdf-render-scheduler/src/lib.rs",
        "lege-pdf/render/crates/pdf-render-cpu/src/prepared.rs"
    ]
    author "dk"
}

record lege-ecosystem-perf.renderer-headsup.merged-three-areas-20261104/1 : observation {
    title "Merged per-area work: Lege leads Hayro on 4/8 documents serially, bit-identical, faster everywhere"
    state verified
    statement """
        After merging the three per-area branches (jp2lam serial decode 945a9cc9, text/vector fill f6c2566c, image draw
        kernels 035660da) the renderer is bit-identical to 5951f37a on 3698/3698 corpus page renders and faster on every
        private test document: 1.0x (viaduct, pure vector, untouched) to 4.2x (xenosystems at 8 workers). Against Hayro
        0.9.0, serial P-core pinned at 144 DPI, Lege now leads 4 of 8 (xenosystems 1.29x, chinese-medicine 1.28x, sahib
        1.22x, beans 1.38x), ties centralpark (0.97) and trails Structures 0.74 (JBIG2 generic decode ~6 ns/px and masked
        draw missing the area-min fast path), viaduct 0.67 (vector fill untouched), vogtle 0.85 (1.02 at 72 DPI). At 8
        workers vogtle drops to 0.59: Lege scales 2.0x vs Hayro 2.9x on a 22-page book, a pipeline ramp cost. pdf-render is
        behind both everywhere. Tests: 626 renderer-crate + 464 jp2lam, 0 failed. Evidence:
        .agent/scratch/pdf-render-headsup-20261104/variance-investigation.md section 10, variance-investigation/merged/,
        and the three notes in dev-notes/lege-pdf/render-refinement/performance-history/*-20261104.md.
        """
    observed_at git:9c93b580bf068a22f1dc8057134708867d6be1df
    method command
    watches [
        "lege-pdf/render/crates/pdf-render-cpu/src/exec.rs",
