akr 0.1
project lege-docwrite

record docwrite.milestone.m1-editor-spike/1 : milestone {
    title "M1 — editor spike: one editable paged document at full speed"
    state superseded
    intent """
        One editable paged document with caret, selection, undo/redo, Unicode and IME input,
        paragraphs, real font shaping, exact PageUp/PageDown and snap-on-gesture-end,
        incremental pagination and latency instrumentation. Prove that 200–500 pages remain
        instantaneous before anything ornamental is built.
        """
    acceptance {
        check convergent-repagination {
            statement """
                An edit on page 147 of 400 re-lays only the pages up to convergence; an instrumented count shows pages 149–400 receive no layout work.
                """
            method command
            command "cargo test -p docwrite-typeset --test incremental"
            verified_by [ @docwrite.evidence.m1-incremental/1 ]
        }
        check edit-basics {
            statement """
                Insert, delete, selection extend, word motion, cut/copy/paste and undo/redo round-trip correctly across paragraph and page boundaries.
                """
            method command
            command "cargo test -p docwrite-model"
            verified_by [ @docwrite.evidence.m1-edit-basics/1 ]
        }
        check exact-paging {
            statement """
                PageDown/PageUp from any scroll position land exactly on the next/previous page top, and a scroll gesture that ends between pages settles onto the nearer page.
                """
            method command
            command "cargo test -p docwrite-app --test navigation"
            verified_by [ @docwrite.evidence.m1-navigation/1 ]
        }
        check five-hundred-pages {
            statement """
                A generated 500-page document opens, scrolls and pages without dropped frames, and typing at any page stays within the keypress-to-present budget.
                """
            method command
            command "cargo test -p docwrite-app --test latency_gate"
            verified_by [ @docwrite.evidence.m1-latency/1 ]
        }
    }
    depends_on [
        @docwrite.decision.incremental-pagination,
        @docwrite.decision.text-stack,
        @docwrite.decision.ui-stack-pixelkit,
        @pixelkit.work.ime,
        @pixelkit.work.key-input,
        @pixelkit.work.latency-phase,
        @pixelkit.work.presenter-injection,
        @pixelkit.work.scroll-phase-gestures
    ]
}

