record docwrite.milestone.m2-book-core/1 : milestone {
    title "M2 — book core: the first useful release"
    state superseded
    intent """
        Chapters and parts, the Book Map with drag reorder, semantic paragraph/character styles,
        page masters, chapter templates, facing pages, margins, page numbers, running heads,
        recto starts, save/load in the .legebook bundle with atomic autosave, and Markdown and
        searchable PDF export.
        """
    acceptance {
        check exports {
            statement """
                The book exports to a searchable PDF (text extractable via lege-pdf-read, bookmarks per chapter, subset fonts) and to structurally clean Markdown.
                """
            method command
            command "cargo test -p docwrite-export"
            verified_by [ @docwrite.evidence.m2-exports/1 ]
        }
        check global-style-change {
            statement """
                Changing the Body style reflows the whole book correctly, and the result matches a fresh layout of the same content.
                """
            method command
            command "cargo test -p docwrite-typeset --test restyle"
            verified_by [ @docwrite.evidence.m2-restyle/1 ]
        }
        check reorder-and-reopen {
            statement """
                Chapters reordered in the Book Map reorder the book; closing and reopening restores the manuscript, styles and position without loss.
                """
            method command
            command "cargo test -p docwrite-model --test persistence"
            verified_by [ @docwrite.evidence.m2-persistence/1 ]
        }
        check ten-chapter-book {
            statement """
                A new book gets ten chapters from one chapter template; editing the template changes all ten openers.
                """
            method manual
            verified_by [ @docwrite.evidence.m2-persistence/1 ]
        }
    }
    after [ @docwrite.milestone.m1-editor-spike ]
    depends_on [
        @docwrite.decision.export-formats,
        @docwrite.decision.persistence-bundle,
        @docwrite.decision.styles-masters-templates,
        @lege.work.font-subsetting-and-cff,
        @lege.work.links-labels-destinations,
        @lege.work.multi-font-pages-and-tounicode,
        @lege.work.vector-paths-and-color
    ]
}

