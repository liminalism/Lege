record docwrite.milestone.m6-writer-ready/1 : milestone {
    title "M6 — writer-ready: the gaps behind M1–M5"
    state proposed
    intent """
        Close the gaps the 2026-09-24 review found behind the completed M1–M5 records, so a
        writer can draft a real book in the window: measured footnotes, every chapter start
        rule and page master honoured, real drop caps, a glyph cache that renders any size,
        CFF fonts in PDF, and in-window commands for chapters and styles.
        """
    acceptance {
        check chapter-rules {
            statement """
                A NextPage chapter starts a new page, a NextRecto chapter a new recto, and each
                chapter lays out with its own template's page master.
                """
            method command
            command "cargo test -p docwrite-typeset --test book_layout"
            verified_by [ @docwrite.evidence.chapter-rules-and-masters/1 ]
        }
        check measured-footnotes {
            statement """
                Footnotes are set at footnote size, reserve their measured height on the page of
                their reference, and split by lines rather than by a character count; a fresh
                and an incremental layout agree.
                """
            method command
            command "cargo test -p docwrite-typeset --test footnotes"
            verified_by [ @docwrite.evidence.measured-footnotes/1 ]
        }
        check window-draft {
            statement """
                In the window, a writer can add, rename and reorder chapters, change the body
                style, type across a page turn, save, reopen and export a PDF that matches the
                screen.
                """
            method manual
        }
    }
    after [ @docwrite.milestone.m5-interchange ]
    depends_on [ @docwrite.observation.milestones-closed-on-synthetic-paths ]
}

record docwrite.milestone.m7-open-items/1 : milestone {
    title "M7 — images, bidi, IDML spreads, CFF and PDF links"
    state proposed
    intent """
        What the 2026-09-24 session left open: images in the page flow, right-to-left
        text, an IDML package InDesign can open, CFF (OpenType-PostScript) fonts and links
        in the PDF, and EPUB if it proves useful.
        """
    acceptance {
        check idml-opens {
            statement """
                An exported IDML opens in InDesign with its styles, parent pages, spreads with
                threaded text frames, story and footnotes.
                """
            method manual
        }
        check images-flow {
            statement """
                An image block is placed in the page flow at its asset's aspect ratio, full
                measure or inline, keeps with its caption, and is embedded in the PDF.
                """
            method command
            command "cargo test -p docwrite-typeset --test images"
        }
    }
    after [ @docwrite.milestone.m6-writer-ready ]
}
