record docwrite.milestone.m4-research-apparatus/1 : milestone {
    title "M4 — research and apparatus"
    state superseded
    intent """
        Footnotes and endnotes with page-local placement, Source records, Source Notes captured
        from a Lege PDF opened beside the manuscript (document, page, passage, bibliographic
        metadata, annotation), citations and quotations inserted from them, click-through back to
        the exact source page, a bibliography, index terms, "sources used in this chapter", and
        CSL JSON / BibTeX import and export.
        """
    acceptance {
        check footnotes-paginate {
            statement """
                Footnotes land on the page of their reference, split across pages when needed, and remain correct under incremental repagination.
                """
            method command
            command "cargo test -p docwrite-typeset --test footnotes"
            verified_by [ @docwrite.evidence.m4-footnotes/1 ]
        }
        check source-roundtrip {
            statement """
                A passage selected in a source PDF becomes a Source Note, is cited in the manuscript, and the citation reopens the source at the same page and highlights the same rectangles.
                """
            method manual
            verified_by [ @docwrite.evidence.m4-source/1 ]
        }
    }
    after [ @docwrite.milestone.m3-prose-typography ]
    supported_by [ @docwrite.observation.pdf-text-supports-source-passages ]
}

