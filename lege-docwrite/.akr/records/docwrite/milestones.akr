record docwrite.milestone.m3-prose-typography/1 : milestone {
    title "M3 — serious prose typography"
    state superseded
    intent """
        Hyphenation, widow/orphan control, keep-with-next and keep-lines-together, first
        paragraph rules, optional drop caps, block quotes and epigraphs, image/caption flow,
        front and back matter, a generated table of contents, small caps and old-style figures
        through OpenType features.
        """
    acceptance {
        check generated-toc {
            statement """
                The table of contents regenerates with correct page numbers after edits that move chapters across pages.
                """
            method command
            command "cargo test -p docwrite-typeset --test toc"
            verified_by [ @docwrite.evidence.m3-toc/1 ]
        }
        check paragraph-rules {
            statement """
                Widow/orphan, keep-with-next and keep-lines-together hold across a corpus of test chapters with no violations.
                """
            method command
            command "cargo test -p docwrite-typeset --test paragraph_rules"
            verified_by [ @docwrite.evidence.m3-rules/1 ]
        }
    }
    after [ @docwrite.milestone.m2-book-core ]
}

