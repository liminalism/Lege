record docwrite.evidence.window-features-2026-09-24/1 : evidence {
    title "Editor commands, toolbar, sidebar, full screen, spreads, research pane, find/replace and typography pass their tests"
    state verified
    result pass
    method command
    observed_at git:987c32fee7cb49205649306dd7c7a89fb6976efe
    command "cargo test (lege-docwrite workspace: 92 tests) and cargo clippy --all-targets (no warnings)"
    summary """
        Covers: resizable Book Map folding to a tab; WordPerfect-style full screen with a
        status line; spread view; toolbar marks, styles, sizes, chapter/rename/note
        prompts; find, find-again, replace-all (one undo); smart quotes/dashes/ellipses;
        research pane capture, quote, cite and citation follow-through; lossless format-2
        bundles with format-1 migration and crash-safe swap; bold/italic families,
        justification, indents, drop caps, synthesized small caps; contents, Notes,
        Bibliography and Index sections. Views were also checked in offscreen PNG
        snapshots. Not covered: an interactive session in the window by a person.
        """
}
