record docwrite.evidence.head-exports/1 : evidence {
    title "Markdown keeps the title and the link and drops page geometry. The PDF citation resolves to page 0 with highlight rects [[72.0, -90.0, 198.0, -72.0]] for Chapter. Tagged PDF has /Lang and /StructTreeRoot. Subset font is 9184 bytes against a 512672-byte face. IDML contains styles, parent pages, a threaded story, an anchored image, and footnotes."
    state verified
    result pass
    method command
    observed_at git:5e5eba9741fb8cbc9d1447239eeb7c4bbb352763
    command "cargo test -p docwrite-export"
    summary """
        Markdown keeps the title and the link and drops page geometry. The PDF citation resolves to page 0 with highlight rects [[72.0, -90.0, 198.0, -72.0]] for Chapter. Tagged PDF has /Lang and /StructTreeRoot. Subset font is 9184 bytes against a 512672-byte face. IDML contains styles, parent pages, a threaded story, an anchored image, and footnotes.
        """
}

